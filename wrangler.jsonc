{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinica",
  "compatibility_date": "2026-03-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js",
  "vars": {
    "LUNA_PATIENTS_ENABLED": "true",
    "LUNA_PATIENTS_MODEL": "gpt-5.4-mini-2026-03-17"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LUNA_PATIENTS_BUDGET",
        "class_name": "LunaBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "luna-budget-v1",
      "new_sqlite_classes": [
        "LunaBudget"
      ]
    }
  ]
}
